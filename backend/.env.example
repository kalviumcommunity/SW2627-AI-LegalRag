# Copy this file to `.env` and fill in real values. Never commit `.env` with secrets.
# Application
APP_NAME=property-intelligence-api
APP_ENV=development
API_PREFIX=/api/v1

# LLM provider: Groq (free tier, OpenAI-compatible endpoint)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# LLM request tuning
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
LLM_MAX_REQUEST_CHARS=2000
LLM_REASONING_EFFORT=low

# Document ingestion (Phase 2)
# Maximum multipart upload size in bytes (default 10 MiB).
DOCUMENT_MAX_UPLOAD_BYTES=10485760
# Comma-separated, dot-free extensions.
DOCUMENT_ALLOWED_EXTENSIONS=pdf,txt,md
# Character-based chunking (approx. 800 tokens / 120 overlap at ~4 chars/token).
DOCUMENT_CHUNK_SIZE_CHARS=3200
DOCUMENT_CHUNK_OVERLAP_CHARS=480
# Minimum fraction of the chunk size before a preferred boundary is used.
DOCUMENT_CHUNK_MIN_SPLIT_RATIO=0.5
# Optional private temp directory; OS temp is used when unset.
# DOCUMENT_TEMP_DIR=

# --- Phase 3: embeddings + PostgreSQL/pgvector -------------------------------
# Required for ingestion and retrieval. Use a dedicated database/user in production.
# DATABASE_URL=postgresql+psycopg://property:property_dev_password@localhost:5433/property_intelligence
DATABASE_URL=
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Embedding provider: fastembed (local, free) or openai (API key required).
EMBEDDING_PROVIDER=fastembed
# Local default: 768 dimensions, 8192-token context, ~130 MB quantized ONNX model.
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5-Q
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
# Must match the pgvector column created by `alembic upgrade head`.
# EMBEDDING_CACHE_DIR=
# Only for EMBEDDING_PROVIDER=openai (placeholder values only).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_TIMEOUT_SECONDS=30

# --- Phase 4: retrieval -------------------------------------------------------
# Used when a search request omits top_k.
RETRIEVAL_DEFAULT_TOP_K=5
# Maximum top_k accepted by the service/API.
RETRIEVAL_MAX_TOP_K=50
# Maximum normalized query length in characters.
RETRIEVAL_MAX_QUERY_CHARS=2000
# Candidate pool per retriever before hybrid RRF fusion.
RETRIEVAL_HYBRID_CANDIDATE_LIMIT=50
# RRF rank-smoothing constant: score += 1 / (RETRIEVAL_RRF_K + rank).
RETRIEVAL_RRF_K=60

# --- Phase 5: grounded RAG ----------------------------------------------------
# Question limit enforced by the RAG service (must not exceed the retrieval limit).
RAG_MAX_QUESTION_CHARS=2000
# Estimated total prompt-token budget, including the system prompt and question.
RAG_CONTEXT_MAX_TOKENS=4000
# Output-token reservation for the grounded answer.
RAG_MAX_OUTPUT_TOKENS=1024
# Retrieval candidates included at most; values above the retrieval max are invalid.
RAG_MAX_EVIDENCE_CHUNKS=8
# Total and per-chunk character caps for evidence included in the prompt.
RAG_MAX_EVIDENCE_CHARS=8000
RAG_MAX_EVIDENCE_CHUNK_CHARS=1600
# Citation excerpt length and maximum generated answer length.
RAG_MAX_EXCERPT_CHARS=280
RAG_MAX_ANSWER_CHARS=6000
# Conservative estimator: ceil(chars / chars_per_token * safety_factor).
RAG_CHARS_PER_TOKEN=4.0
RAG_TOKEN_SAFETY_FACTOR=1.2
# Weak-evidence policy: semantic cosine floor and hybrid keyword-only rank cap.
# A score above the floor is never proof of sufficiency by itself.
RAG_MIN_SEMANTIC_SCORE=0.35
RAG_MAX_KEYWORD_ONLY_RANK=20
# Omit same-document chunks whose character ranges overlap by this fraction.
RAG_OVERLAP_DEDUP_RATIO=0.5
# Conservative model context window for prompt + reserved output fit checks.
RAG_MODEL_CONTEXT_TOKENS=32768
