# Copy this file to `.env` and fill in real values. Never commit `.env` with secrets.
# Application
APP_NAME=property-intelligence-api
APP_ENV=development
API_PREFIX=/api/v1

# LLM provider: Groq (free tier, OpenAI-compatible endpoint)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# LLM request tuning
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
LLM_MAX_REQUEST_CHARS=2000
LLM_REASONING_EFFORT=low
