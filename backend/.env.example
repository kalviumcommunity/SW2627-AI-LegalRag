# Copy this file to `.env` and fill in real values. Never commit `.env` with secrets.
# Application
APP_NAME=property-intelligence-api
APP_ENV=development
API_PREFIX=/api/v1

# LLM provider: Groq (free tier, OpenAI-compatible endpoint)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# LLM request tuning
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
LLM_MAX_REQUEST_CHARS=2000
LLM_REASONING_EFFORT=low

# Document ingestion (Phase 2)
# Maximum multipart upload size in bytes (default 10 MiB).
DOCUMENT_MAX_UPLOAD_BYTES=10485760
# Comma-separated, dot-free extensions.
DOCUMENT_ALLOWED_EXTENSIONS=pdf,txt,md
# Character-based chunking (approx. 800 tokens / 120 overlap at ~4 chars/token).
DOCUMENT_CHUNK_SIZE_CHARS=3200
DOCUMENT_CHUNK_OVERLAP_CHARS=480
# Minimum fraction of the chunk size before a preferred boundary is used.
DOCUMENT_CHUNK_MIN_SPLIT_RATIO=0.5
# Optional private temp directory; OS temp is used when unset.
# DOCUMENT_TEMP_DIR=
