# Copy this file to `.env` and fill in real values. Never commit `.env` with secrets.
# Application
APP_NAME=property-intelligence-api
APP_ENV=development
API_PREFIX=/api/v1

# LLM provider: Groq (free tier, OpenAI-compatible endpoint)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# LLM request tuning
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
LLM_MAX_REQUEST_CHARS=2000
LLM_REASONING_EFFORT=low

# Document ingestion (Phase 2)
# Maximum multipart upload size in bytes (default 10 MiB).
DOCUMENT_MAX_UPLOAD_BYTES=10485760
# Comma-separated, dot-free extensions.
DOCUMENT_ALLOWED_EXTENSIONS=pdf,txt,md
# Character-based chunking (approx. 800 tokens / 120 overlap at ~4 chars/token).
DOCUMENT_CHUNK_SIZE_CHARS=3200
DOCUMENT_CHUNK_OVERLAP_CHARS=480
# Minimum fraction of the chunk size before a preferred boundary is used.
DOCUMENT_CHUNK_MIN_SPLIT_RATIO=0.5
# Optional private temp directory; OS temp is used when unset.
# DOCUMENT_TEMP_DIR=

# --- Phase 3: embeddings + PostgreSQL/pgvector -------------------------------
# Required for ingestion and retrieval. Use a dedicated database/user in production.
# DATABASE_URL=postgresql+psycopg://property:property_dev_password@localhost:5433/property_intelligence
DATABASE_URL=
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Embedding provider: fastembed (local, free) or openai (API key required).
EMBEDDING_PROVIDER=fastembed
# Local default: 768 dimensions, 8192-token context, ~130 MB quantized ONNX model.
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5-Q
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
# Must match the pgvector column created by `alembic upgrade head`.
# EMBEDDING_CACHE_DIR=
# Only for EMBEDDING_PROVIDER=openai (placeholder values only).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_TIMEOUT_SECONDS=30

# --- Phase 4: retrieval -------------------------------------------------------
# Used when a search request omits top_k.
RETRIEVAL_DEFAULT_TOP_K=5
# Maximum top_k accepted by the service/API.
RETRIEVAL_MAX_TOP_K=50
# Maximum normalized query length in characters.
RETRIEVAL_MAX_QUERY_CHARS=2000
# Candidate pool per retriever before hybrid RRF fusion.
RETRIEVAL_HYBRID_CANDIDATE_LIMIT=50
# RRF rank-smoothing constant: score += 1 / (RETRIEVAL_RRF_K + rank).
RETRIEVAL_RRF_K=60
